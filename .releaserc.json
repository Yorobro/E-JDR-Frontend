{
  "branches": ["main"],
  "plugins": [
    ["@semantic-release/commit-analyzer", {"preset": "conventionalcommits"}],
    ["@semantic-release/release-notes-generator", {"preset": "conventionalcommits"}],
    ["@semantic-release/changelog", {"changelogFile": "CHANGELOG.md"}],
    ["@semantic-release/exec", {"prepareCmd": "node ./scripts/set-version.js ${nextRelease.version}"}],
    ["@semantic-release/git", {"assets": ["gradle.properties", "CHANGELOG.md"], "message": "chore(release): ${nextRelease.version} [skip ci]"}],
    "@semantic-release/github"
  ]
}
