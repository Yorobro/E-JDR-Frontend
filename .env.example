# Configuration locale E-JDR — copier ce fichier en `.env` puis adapter.
# Le fichier `.env` n'est jamais commité (cf. .gitignore).
#
# Ordre de priorité : variable d'environnement OS > .env > valeur par défaut (prod).

# URL de base de l'API ciblée.
#   - Dev  (backend local)    : http://localhost:3000
#   - Prod (défaut si absent) : https://ejdr-backend.vyxs.fr
EJDR_API_URL=http://localhost:3000

# Active le logging HTTP détaillé du client Ktor (true/false).
EJDR_HTTP_LOG=false
